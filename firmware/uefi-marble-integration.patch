diff --git a/BootShim/BootShim.S b/BootShim/BootShim.S
index 4d208553..7b7bc513 100644
--- a/BootShim/BootShim.S
+++ b/BootShim/BootShim.S
@@ -7,7 +7,7 @@ _StackBase:
   .quad FD_BASE         /* Text Offset */
 
 _StackSize:
-  .quad FD_SIZE         /* Image Size */
+  .quad FD_SIZE + _Payload - _Head /* Image Size: shim + firmware volume */
   .quad 0               /* Flags */
   .quad 0               /* Reserved */
   .quad 0               /* Reserved */
diff --git a/Platforms/Xiaomi/marblePkg/marble.dsc b/Platforms/Xiaomi/marblePkg/marble.dsc
index f720604a..a6fa733b 100755
--- a/Platforms/Xiaomi/marblePkg/marble.dsc
