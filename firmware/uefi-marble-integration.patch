index c5d25f00..fe483a68 100644
--- a/Silicon/Qualcomm/PalimaPkg/PalimaPkg.dsc.inc
+++ b/Silicon/Qualcomm/PalimaPkg/PalimaPkg.dsc.inc
@@ -90,3 +90,13 @@
   # Custom Drivers
   #
   QcomPkg/Drivers/IortDtDxe/IortDtDxe.inf
+
+!if $(UNIXNU_PAYLOAD) == 1
+  #
+  # UniXNU boot chain: boot manager, registrar, FDT RAM disk and XNU loader.
+  #
+  UniXNUPkg/Application/UniXNU/UniXNU.inf
+  UniXNUPkg/Driver/UniXNUDxe/UniXNUDxe.inf
+  UniXNUPkg/Driver/UniXNURamDiskDxe/UniXNURamDiskDxe.inf
+  DarwinBootPkg/Driver/DarwinBoot.inf
+!endif
diff --git a/Silicon/Silicium/SiliciumPkg/Sec/AArch64/ModuleEntryPoint.S b/Silicon/Silicium/SiliciumPkg/Sec/AArch64/ModuleEntryPoint.S
index f2ce0403..eb235972 100644
--- a/Silicon/Silicium/SiliciumPkg/Sec/AArch64/ModuleEntryPoint.S
+++ b/Silicon/Silicium/SiliciumPkg/Sec/AArch64/ModuleEntryPoint.S
@@ -13,6 +13,10 @@
 .set CTRL_SPAN_BIT, (1 << 23)
 
 ASM_FUNC (_ModuleEntryPoint)
+  // x0 is the firmware device tree supplied by the bootloader. Keep it
+  // across the stack setup and pass it to CEntryPoint as the third argument.
+  mov   x19, x0
+
   // Do Platform Specific Initialization
   bl    ASM_PFX (PlatformAssemblyInitialize)
 
@@ -50,15 +54,16 @@ ASM_PFX (MainEntryPoint):
   cmp   x8, x7
   b.lt  0b
 
-  // Pass Parameters
+  // Pass Parameters: stack base, stack size, bootloader FDT address.
   mov   x0, x8
   mov   x1, x9
+  mov   x2, x19
 
   // Set Jump Location
-  ldr   x2, =ASM_PFX (CEntryPoint)
+  ldr   x3, =ASM_PFX (CEntryPoint)
 
   // Clear Frame pointer
   mov   x29, xzr
 
   // Jump to C Code
-  blr   x2
+  blr   x3
diff --git a/Silicon/Silicium/SiliciumPkg/Sec/Sec.c b/Silicon/Silicium/SiliciumPkg/Sec/Sec.c
index deb32fdc..64b9f2e8 100644
--- a/Silicon/Silicium/SiliciumPkg/Sec/Sec.c
+++ b/Silicon/Silicium/SiliciumPkg/Sec/Sec.c
@@ -18,6 +18,14 @@
 
 #include "Sec.h"
 
+//
+// UniXNU entry-argument HOB: carries the FDT physical address the bootloader
+// passed in x0. UniXNURamDiskDxe reads it to publish the initrd payload.
+//
+STATIC CONST EFI_GUID  gSiliciumEntryArgHobGuid = {
+  0xDAEE82E6, 0x8090, 0x4E72, { 0xBF, 0xB9, 0x78, 0xC1, 0x3C, 0xD4, 0xE3, 0x59 }
+};
+
 #ifndef MDEPKG_NDEBUG
 STATIC
 VOID
@@ -155,7 +163,8 @@ STATIC
 VOID
 SecMain (
   IN UINTN StackBase,
-  IN UINTN StackSize)
+  IN UINTN StackSize,
+  IN UINTN FdtAddress)
 {
   EFI_STATUS Status;
 
@@ -180,6 +189,12 @@ SecMain (
     return;
   }
 
+  // Publish the bootloader FDT address for the UniXNU RAM-disk driver.
+  if (FdtAddress != 0) {
+    UINT64 EntryArg = (UINT64)FdtAddress;
+    BuildGuidDataHob (&gSiliciumEntryArgHobGuid, &EntryArg, sizeof (EntryArg));
+  }
+
   // Build CPU HOB
   BuildCpuHob (ArmGetPhysicalAddressBits (), PcdGet8 (PcdPrePiCpuIoSize));
 
@@ -219,7 +234,8 @@ SecMain (
 VOID
 CEntryPoint (
   IN UINTN StackBase,
-  IN UINTN StackSize)
+  IN UINTN StackSize,
+  IN UINTN FdtAddress)
 {
   // Disable Data Cache
   ArmDisableDataCache ();
@@ -244,7 +260,7 @@ CEntryPoint (
   PlatformInitialize ();
 
   // Enter SEC Main Function
-  SecMain (StackBase, StackSize);
+  SecMain (StackBase, StackSize, FdtAddress);
 
   // Something went Wrong
   CpuDeadLoop ();
