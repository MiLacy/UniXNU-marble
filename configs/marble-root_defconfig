# Unverified UFS tail-root configuration for marble.
#
# The root image is written at the tail of userdata (LBA 59589627, 2,290,688
# 4 KiB blocks); the Android ext4 data at the start of userdata is untouched.
# No verified-root bundle, no Data seed and no display stack are required.
CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
CONFIG_XNU_NATIVE_AES=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_NATIVE_PAN=y
CONFIG_XNU_NATIVE_UFS=y
CONFIG_XNU_NATIVE_UFS_FULL=y
CONFIG_XNU_SHENG_PMGR=y
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_ARMVIRT_PLATFORM=n
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=n
CONFIG_XNU_NATIVE_ADRENO=n
CONFIG_XNU_EXTRA_LD_ARCHIVES="{tree}/build/marble-unverified-root/libMarbleUnverifiedRoot.a {tree}/build/boot-progress/libBootProgress.a"

CONFIG_XNU_VERIFIED_ROOT_PROBE=n
CONFIG_XNU_OWNER_ROOT_AUDIT=n
CONFIG_XNU_OWNER_ROOT_TRUST=n
CONFIG_XNU_NATIVE_VIRTIO_BLOCK=n
CONFIG_XNU_OWNER_CACHE_MOUNT=y
# Development-only bypass for the first tail-root bring-up.
CONFIG_XNU_OWNER_CACHE_UNVERIFIED=1
CONFIG_XNU_OWNER_CACHE_STARTUP=y
CONFIG_XNU_OWNER_BOOT_MANIFEST=n
CONFIG_XNU_OWNER_CACHE_VOLUME_UUID="8846FE78-2910-4297-AF97-D59BB6F8FC16"
CONFIG_XNU_OWNER_UNION_SYSTEMOS=y
CONFIG_XNU_OWNER_DATA_MOUNT=n
CONFIG_XNU_NATIVE_RAM_BLOCK=n
CONFIG_XNU_VERIFIED_ROOT_ARCHIVE=""
CONFIG_XNU_NATIVE_VIRTIO_BLOCK_ARCHIVE=""
CONFIG_XNU_BOOT_PROGRESS=y
# Development-only: the unverified root needs the screen console too.
CONFIG_XNU_BOOT_PROGRESS_UNVERIFIED=1
